@model SchoolWeb.Application.Contracts.Pages.MissionPageResponseDto

<h1>@Model.Title</h1>

@if (!string.IsNullOrWhiteSpace(Model.IntroHtml))
{
    <div class="mt-3">
        @Html.Raw(HtmlSanitizer.Sanitize(Model.IntroHtml))
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.MissionHtml))
{
    <div class="mt-3">
        @Html.Raw(HtmlSanitizer.Sanitize(Model.MissionHtml))
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
{
    <div class="mt-3">
        <img class="img-fluid" src="@Model.ImageUrl" alt="Mission image" />
    </div>
}
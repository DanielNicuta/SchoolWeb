@model SchoolWeb.Application.Contracts.Pages.OrganizationPageResponseDto

@{
    ViewData["Title"] = Model.SeoTitle ?? Model.Title;
}

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-card">
            <h1 class="inner-hero-title">@Model.Title</h1>
        </div>
    </div>

    <svg class="inner-hero-wave" viewBox="0 0 1440 200" preserveAspectRatio="none" aria-hidden="true">
        <path fill="rgba(33,70,45,.18)"
              d="M0,140 C240,200 480,100 720,160 C960,220 1200,120 1440,150 L1440,200 L0,200 Z"></path>
        <path fill="#2e5f3e"
              d="M0,120 C260,190 520,80 780,140 C1040,200 1260,120 1440,130 L1440,200 L0,200 Z"></path>
    </svg>
</section>

<section class="inner-page">
    <div class="container">
        <div class="row g-4 align-items-start">

            <!-- LEFT: Description + Download -->
            <div class="col-lg-7">
                <div class="content-card">
                    <div class="content-html">
                        @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                        {
                            @Html.Raw(Model.DescriptionHtml)
                        }
                        else
                        {
                            <p>
                                Our school is organized with clear roles and responsibilities to ensure stability, safety, and effective learning.
                                This structure supports transparent communication with families and consistent daily routines for students.
                            </p>
                        }

                        <div class="org-trust mt-4">
                            <h3>What This Means for Families</h3>
                            <ul>
                                <li><strong>Clarity:</strong> you know who to contact for each topic</li>
                                <li><strong>Consistency:</strong> stable routines that help children feel safe</li>
                                <li><strong>Transparency:</strong> communication that builds trust</li>
                            </ul>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.OrgChartFileUrl))
                        {
                            <div class="mt-4">
                                <a class="btn-cta" href="@Model.OrgChartFileUrl" target="_blank" rel="noopener">
                                    Download Organization Chart
                                </a>
                                <div class="small text-muted mt-2">
                                    PDF / Document with the school’s organization structure.
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT: Org Chart Image -->
            <div class="col-lg-5">
                <div class="side-card">
                    @if (!string.IsNullOrWhiteSpace(Model.OrgChartImageUrl))
                    {
                        <img class="side-image" src="@Model.OrgChartImageUrl" alt="School organization chart" />
                        <div class="small text-muted mt-2">
                            Organization chart overview.
                        </div>
                    }
                    else
                    {
                        <div class="side-placeholder">
                            <div class="side-placeholder-title">Organization Chart</div>
                            <div class="side-placeholder-text">
                                Upload a chart image from Admin to show the structure clearly.
                            </div>
                        </div>
                    }

                    <div class="side-cta">
                        <a class="btn-cta" href="/contact">Contact Administration</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
@model SchoolWeb.Application.Contracts.Public.HomeDto

@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (Model is null)
{
    <p>No content.</p>
}
else
{
    <h1>@Model.HeroTitle</h1>
    @if (!string.IsNullOrWhiteSpace(Model.HeroSubtitle))
    {
        <p>@Model.HeroSubtitle</p>
    }
}

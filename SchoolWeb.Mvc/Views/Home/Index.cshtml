@model SchoolWeb.Application.Contracts.Pages.CmsPageDto

<h1>@(Model.Title ?? "Home")</h1>

@if (Model.Content is null || Model.Content.Count == 0)
{
    <p>No content configured.</p>
}
else
{
    <pre>@System.Text.Json.JsonSerializer.Serialize(Model.Content, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
}

@model SchoolWeb.Application.Contracts.Pages.FooterContentResponseDto

<footer class="border-top footer text-muted">
    <div class="container">
        @if (Model?.FooterText is null)
        {
            <span>Footer not configured.</span>
        }
        else
        {
            <span>@(Model.NewsletterTitle ?? "Footer")</span>
        }
    </div>
</footer>

@model SchoolWeb.Application.Contracts.Pages.FooterContentResponseDto?
@using System.Text.Json

@{
    List<(string Text, string Url)> ParseLinks(string? json)
    {
        var result = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(json)) return result;

        using var doc = JsonDocument.Parse(json);
        if (doc.RootElement.ValueKind != JsonValueKind.Array) return result;

        foreach (var item in doc.RootElement.EnumerateArray())
        {
            var text = item.TryGetProperty("text", out var t) ? t.GetString() : null;
            var url = item.TryGetProperty("url", out var u) ? u.GetString() : null;

            if (!string.IsNullOrWhiteSpace(text) && !string.IsNullOrWhiteSpace(url))
                result.Add((text!, url!));
        }

        return result;
    }

    var quickLinks = Model is null ? new List<(string Text, string Url)>() : ParseLinks(Model.UsefulLinksJson);
    var socialLinks = Model is null ? new List<(string Text, string Url)>() : ParseLinks(Model.SocialLinksJson);
    var year = DateTime.UtcNow.Year;
}

<footer class="site-footer mt-5 pt-5">
    <div class="container py-4">
        <div class="row g-4 align-items-start">

            <!-- Brand / About -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img src="~/images/logo-icon.png" alt="School Logo" style="height:34px;" />
                    <span class="footer-brand">School Web</span>
                </div>

                <p class="text-muted mb-3">
                    @(string.IsNullOrWhiteSpace(Model?.FooterText)
                        ? "A safe, supportive school community focused on strong learning, kindness, and real-world skills."
                        : Model!.FooterText)
                </p>

                <div class="mt-3">
                    <div class="fw-bold footer-title" style="font-size:1rem;">@(Model?.NewsletterTitle ?? "Stay Connected")</div>
                    <div class="text-muted">
                        @(Model?.NewsletterText ?? "Get school updates, events, and announcements. No spam — only what matters.")
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-6 col-lg-4">
                <div class="footer-title">Quick Links</div>

                <ul class="list-unstyled footer-links mb-0">
                    @if (quickLinks.Count > 0)
                    {
                        foreach (var (text, url) in quickLinks)
                        {
                            <li class="mb-2"><a href="@url" rel="noopener">@text</a></li>
                        }
                    }
                    else
                    {
                        <li class="mb-2"><a href="/history">History</a></li>
                        <li class="mb-2"><a href="/mission">Mission</a></li>
                        <li class="mb-2"><a href="/organization">Organization</a></li>
                        <li class="mb-2"><a href="/links">Links</a></li>
                        <li class="mb-2"><a href="/contact">Contact</a></li>
                    }
                </ul>
            </div>

            <!-- Social -->
            <div class="col-6 col-lg-4">
                <div class="footer-title">Social</div>

                @if (socialLinks.Count > 0)
                {
                    <ul class="list-unstyled footer-links mb-0">
                        @foreach (var (text, url) in socialLinks)
                        {
                            <li class="mb-2"><a href="@url" rel="noopener">@text</a></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Add social links from Admin → Footer.</p>
                }
            </div>
        </div>

        <hr class="my-4" />

        <div class="footer-bottom text-muted small">
            <div>© @year School Web. All rights reserved.</div>
            <div>Built with .NET & Bootstrap.</div>
        </div>
    </div>
</footer>
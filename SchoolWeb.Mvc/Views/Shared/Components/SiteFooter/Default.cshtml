@model SchoolWeb.Application.Contracts.Pages.FooterContentResponseDto?

@using System.Text.Json

@{
    // Will be moved to UseCases
    List<(string Text, string Url)> ParseLinks(string? json)
    {
        var result = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(json)) return result;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Array) return result;

            foreach (var item in doc.RootElement.EnumerateArray())
            {
                var text = item.TryGetProperty("text", out var t) ? t.GetString() : null;
                var url = item.TryGetProperty("url", out var u) ? u.GetString() : null;

                if (!string.IsNullOrWhiteSpace(text) && !string.IsNullOrWhiteSpace(url))
                    result.Add((text!, url!));
            }
        }
        catch
        {
            
        }

        return result;
    }

    var quickLinks = Model is null ? new List<(string Text, string Url)>() : ParseLinks(Model.UsefulLinksJson);
    var socialLinks = Model is null ? new List<(string Text, string Url)>() : ParseLinks(Model.SocialLinksJson);

    var year = DateTime.UtcNow.Year;

    // Fallback links (only used when CMS is empty)
    var fallbackQuickLinks = new List<(string Text, string Url)>
    {
        ("History", "/history"),
        ("Mission", "/mission"),
        ("Organization", "/organization"),
        ("Links", "/links"),
        ("Contact", "/contact")
    };
}

<footer class="site-footer">
    <div class="container">
        <div class="row footer-top g-4">

            <!-- Column 1: Brand + Text + Newsletter -->
            <div class="col-lg-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="~/images/logo-icon.png" alt="School Logo" style="width:36px;height:36px;" />
                    <strong class="footer-title mb-0">School Web</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model?.FooterText))
                {
                    <p class="footer-muted mb-3">@Model!.FooterText</p>
                }
                else
                {
                    <p class="footer-muted mb-3">
                        Official school website. News, resources, and useful information for students and parents.
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(Model?.NewsletterTitle))
                {
                    <div class="footer-title">@Model!.NewsletterTitle</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model?.NewsletterText))
                {
                    <p class="footer-muted mb-0">@Model!.NewsletterText</p>
                }
            </div>

            <!-- Column 2: Quick Links -->
            <div class="col-lg-4">
                <div class="footer-title">Quick Links</div>

                <div class="footer-links d-flex flex-column">
                    @if (quickLinks.Count > 0)
                    {
                        @foreach (var (text, url) in quickLinks)
                        {
                            <a href="@url" rel="noopener">@text</a>
                        }
                    }
                    else
                    {
                        @foreach (var (text, url) in fallbackQuickLinks)
                        {
                            <a href="@url">@text</a>
                        }
                    }
                </div>
            </div>

            <!-- Column 3: Social -->
            <div class="col-lg-4">
                <div class="footer-title">Social</div>

                @if (socialLinks.Count > 0)
                {
                    <div class="footer-links d-flex flex-column">
                        @foreach (var (text, url) in socialLinks)
                        {
                            <a href="@url" rel="noopener">@text</a>
                        }
                    </div>
                }
                else
                {
                    <p class="footer-muted mb-0">Add social links from Admin → Footer.</p>
                }
            </div>

        </div>

        <div class="footer-bottom d-flex justify-content-between flex-wrap gap-2">
            <div>© @year School Web. All rights reserved.</div>
            <div>Built with .NET & Bootstrap.</div>
        </div>
    </div>
</footer>
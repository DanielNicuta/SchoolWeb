@model SchoolWeb.Application.Contracts.Pages.FooterContentResponseDto?

@if (Model is not null)
{
    <footer class="mt-5 pt-4 border-top">
        @if (!string.IsNullOrWhiteSpace(Model.FooterText))
        {
            <div>@Model.FooterText</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.NewsletterTitle))
        {
            <h5 class="mt-3">@Model.NewsletterTitle</h5>
        }

        @if (!string.IsNullOrWhiteSpace(Model.NewsletterText))
        {
            <p>@Model.NewsletterText</p>
        }
    </footer>
}
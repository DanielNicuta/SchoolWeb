@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Error";
}

<div class="admin-error-wrapper text-center py-5">

    <div class="admin-error-icon mb-3">
        ⚙️
    </div>

    <h2 class="fw-bold mb-3">
        System error detected
    </h2>

    <p class="text-muted mb-4">
        Something went wrong while processing your request.  
        The issue has been logged and will be reviewed shortly.
    </p>

    <a asp-area="Admin"
       asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-success">
        Return to Dashboard
    </a>

</div>
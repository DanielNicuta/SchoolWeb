@model SchoolWeb.Application.Contracts.Pages.MissionPageUpdateDto
@{
    ViewData["Title"] = "Edit Mission";
}

<div class="admin-card">
    <div class="admin-card-header">Mission Page</div>
    <div class="admin-card-body">

        <p class="text-muted mb-4">
            Mission should be easy to scan: short introduction, then 3–5 clear commitments (values, safety, learning, community).
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger admin-alert" role="alert">
                @Html.ValidationSummary()
            </div>
        }

        <form asp-area="Admin" asp-controller="Pages" asp-action="Mission" method="post">
            @Html.AntiForgeryToken()

            <div class="admin-card mb-3">
                <div class="admin-card-header">Header</div>
                <div class="admin-card-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-lg-6">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">Introduction</div>
                <div class="admin-card-body">
                    <label asp-for="IntroHtml" class="form-label"></label>
                    <textarea asp-for="IntroHtml" class="form-control" rows="6"></textarea>
                    <div class="form-text">A short “why we exist” paragraph. 3–5 lines is perfect.</div>
                    <span asp-validation-for="IntroHtml" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">Mission statement</div>
                <div class="admin-card-body">
                    <label asp-for="MissionHtml" class="form-label"></label>
                    <textarea asp-for="MissionHtml" class="form-control" rows="10"></textarea>
                    <div class="form-text">Recommended: a list of commitments (bullets) for clarity.</div>
                    <span asp-validation-for="MissionHtml" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">SEO</div>
                <div class="admin-card-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label asp-for="SeoTitle" class="form-label"></label>
                            <input asp-for="SeoTitle" class="form-control" data-max="60"/>
                            <span asp-validation-for="SeoTitle" class="text-danger"></span>
                        </div>
                        <div class="col-lg-6">
                            <label asp-for="OgImageUrl" class="form-label"></label>
                            <input asp-for="OgImageUrl" class="form-control" data-max="60"/>
                            <span asp-validation-for="OgImageUrl" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SeoDescription" class="form-label"></label>
                            <textarea asp-for="SeoDescription" class="form-control" rows="3" data-max="160"></textarea>
                            <span asp-validation-for="SeoDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="_AdminFormActions"
                model='new SchoolWeb.Mvc.Areas.Admin.ViewsModel.AdminFormActionsViewModel
                {
                    SaveText = "Save",
                    HelpText = "Changes affect the public website immediately.",
                    PreviewUrl = "/",
                    BackUrl = Url.Action("Index","Dashboard", new { area = "Admin" })
                }' />
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
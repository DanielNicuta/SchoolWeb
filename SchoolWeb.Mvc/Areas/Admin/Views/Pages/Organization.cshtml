@model SchoolWeb.Application.Contracts.Pages.OrganizationPageUpdateDto
@{
    ViewData["Title"] = "Edit Organization";
}

<div class="admin-card">
    <div class="admin-card-header">Organization Page</div>
    <div class="admin-card-body">

        <p class="text-muted mb-4">
            Keep organization information transparent and easy to understand. Add a short description and the official org chart.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger admin-alert" role="alert">
                @Html.ValidationSummary()
            </div>
        }

        <form asp-area="Admin" asp-controller="Pages" asp-action="Organization" method="post">
            @Html.AntiForgeryToken()

            <div class="admin-card mb-3">
                <div class="admin-card-header">Header</div>
                <div class="admin-card-body">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">Description</div>
                <div class="admin-card-body">
                    <label asp-for="DescriptionHtml" class="form-label"></label>
                    <textarea asp-for="DescriptionHtml" class="form-control" rows="10"></textarea>
                    <div class="form-text">Explain the structure in plain language (who does what).</div>
                    <span asp-validation-for="DescriptionHtml" class="text-danger"></span>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">Org chart files</div>
                <div class="admin-card-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label asp-for="OrgChartImageUrl" class="form-label"></label>
                            <input asp-for="OrgChartImageUrl" class="form-control" />
                            <div class="form-text">PNG/JPG link for quick preview on the page.</div>
                            <span asp-validation-for="OrgChartImageUrl" class="text-danger"></span>
                        </div>
                        <div class="col-lg-6">
                            <label asp-for="OrgChartFileUrl" class="form-label"></label>
                            <input asp-for="OrgChartFileUrl" class="form-control" />
                            <div class="form-text">PDF link for download (“Official document”).</div>
                            <span asp-validation-for="OrgChartFileUrl" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="admin-card mb-3">
                <div class="admin-card-header">SEO</div>
                <div class="admin-card-body">
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label asp-for="SeoTitle" class="form-label"></label>
                            <input asp-for="SeoTitle" class="form-control" data-max="60"/>
                            <span asp-validation-for="SeoTitle" class="text-danger"></span>
                        </div>
                        <div class="col-lg-6">
                            <label asp-for="OgImageUrl" class="form-label"></label>
                            <input asp-for="OgImageUrl" class="form-control" data-max="60"/>
                            <span asp-validation-for="OgImageUrl" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="SeoDescription" class="form-label"></label>
                            <textarea asp-for="SeoDescription" class="form-control" rows="3" data-max="160"></textarea>
                            <span asp-validation-for="SeoDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="_AdminFormActions"
                model='new SchoolWeb.Mvc.Areas.Admin.ViewsModel.AdminFormActionsViewModel
                {
                    SaveText = "Save",
                    HelpText = "Changes affect the public website immediately.",
                    PreviewUrl = "/",
                    BackUrl = Url.Action("Index","Dashboard", new { area = "Admin" })
                }' />
        </form>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
@model SchoolWeb.Application.Contracts.Pages.HomePageUpdateDto

<h1>Edit Home Page</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger">
        @Html.ValidationSummary()
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <h3>Hero</h3>
    <div class="mb-3">
        <label asp-for="HeroTitle" class="form-label"></label>
        <input asp-for="HeroTitle" class="form-control" />
        <span asp-validation-for="HeroTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HeroSubtitle" class="form-label"></label>
        <input asp-for="HeroSubtitle" class="form-control" />
        <span asp-validation-for="HeroSubtitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HeroButtonText" class="form-label"></label>
        <input asp-for="HeroButtonText" class="form-control" />
        <span asp-validation-for="HeroButtonText" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HeroButtonUrl" class="form-label"></label>
        <input asp-for="HeroButtonUrl" class="form-control" />
        <span asp-validation-for="HeroButtonUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="HeroImageUrl" class="form-label"></label>
        <input asp-for="HeroImageUrl" class="form-control" />
        <span asp-validation-for="HeroImageUrl" class="text-danger"></span>
    </div>

    <hr />

    <h3>About</h3>
    <div class="mb-3">
        <label asp-for="AboutTitle" class="form-label"></label>
        <input asp-for="AboutTitle" class="form-control" />
        <span asp-validation-for="AboutTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AboutSubtitle" class="form-label"></label>
        <input asp-for="AboutSubtitle" class="form-control" />
        <span asp-validation-for="AboutSubtitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AboutHtml" class="form-label"></label>
        <textarea asp-for="AboutHtml" class="form-control" rows="6"></textarea>
        <span asp-validation-for="AboutHtml" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AboutImageUrl" class="form-label"></label>
        <input asp-for="AboutImageUrl" class="form-control" />
        <span asp-validation-for="AboutImageUrl" class="text-danger"></span>
    </div>

    <hr />

    <h3>Highlights</h3>

    <h5>Highlight 1</h5>
    <div class="mb-3"><label asp-for="Highlight1Title" class="form-label"></label><input asp-for="Highlight1Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight1Text" class="form-label"></label><input asp-for="Highlight1Text" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight1Icon" class="form-label"></label><input asp-for="Highlight1Icon" class="form-control" /></div>

    <h5>Highlight 2</h5>
    <div class="mb-3"><label asp-for="Highlight2Title" class="form-label"></label><input asp-for="Highlight2Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight2Text" class="form-label"></label><input asp-for="Highlight2Text" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight2Icon" class="form-label"></label><input asp-for="Highlight2Icon" class="form-control" /></div>

    <h5>Highlight 3</h5>
    <div class="mb-3"><label asp-for="Highlight3Title" class="form-label"></label><input asp-for="Highlight3Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight3Text" class="form-label"></label><input asp-for="Highlight3Text" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Highlight3Icon" class="form-label"></label><input asp-for="Highlight3Icon" class="form-control" /></div>

    <hr />

    <h3>SEO</h3>
    <div class="mb-3">
        <label asp-for="SeoTitle" class="form-label"></label>
        <input asp-for="SeoTitle" class="form-control" />
        <span asp-validation-for="SeoTitle" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SeoDescription" class="form-label"></label>
        <textarea asp-for="SeoDescription" class="form-control" rows="3"></textarea>
        <span asp-validation-for="SeoDescription" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OgImageUrl" class="form-label"></label>
        <input asp-for="OgImageUrl" class="form-control" />
        <span asp-validation-for="OgImageUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
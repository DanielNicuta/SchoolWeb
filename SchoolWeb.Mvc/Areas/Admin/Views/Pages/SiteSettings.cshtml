@model SchoolWeb.Application.Contracts.Pages.SiteSettingsUpdateDto

<h1>Edit Site Settings</h1>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger">
        @Html.ValidationSummary()
    </div>
}

<form asp-area="Admin" asp-controller="Pages" asp-action="SiteSettings" method="post">
    @Html.AntiForgeryToken()

    <h3>Branding</h3>

    <div class="mb-3">
        <label asp-for="SiteName" class="form-label"></label>
        <input asp-for="SiteName" class="form-control" />
        <span asp-validation-for="SiteName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LogoUrl" class="form-label"></label>
        <input asp-for="LogoUrl" class="form-control" />
        <span asp-validation-for="LogoUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FaviconUrl" class="form-label"></label>
        <input asp-for="FaviconUrl" class="form-control" />
        <span asp-validation-for="FaviconUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DefaultLanguage" class="form-label"></label>
        <input asp-for="DefaultLanguage" class="form-control" />
        <span asp-validation-for="DefaultLanguage" class="text-danger"></span>
    </div>

    <hr />

    <h3>Contact</h3>

    <div class="mb-3">
        <label asp-for="ContactEmail" class="form-label"></label>
        <input asp-for="ContactEmail" type="email" class="form-control" />
        <span asp-validation-for="ContactEmail" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactPhone" class="form-label"></label>
        <input asp-for="ContactPhone" class="form-control" />
        <span asp-validation-for="ContactPhone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <hr />

    <h3>Social</h3>

    <div class="mb-3">
        <label asp-for="FacebookUrl" class="form-label"></label>
        <input asp-for="FacebookUrl" class="form-control" />
        <span asp-validation-for="FacebookUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YoutubeUrl" class="form-label"></label>
        <input asp-for="YoutubeUrl" class="form-control" />
        <span asp-validation-for="YoutubeUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TwitterUrl" class="form-label"></label>
        <input asp-for="TwitterUrl" class="form-control" />
        <span asp-validation-for="TwitterUrl" class="text-danger"></span>
    </div>

    <hr />

    <h3>Cookie Banner</h3>

    <div class="mb-3">
        <label asp-for="CookieBannerText" class="form-label"></label>
        <textarea asp-for="CookieBannerText" class="form-control" rows="3"></textarea>
        <span asp-validation-for="CookieBannerText" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}